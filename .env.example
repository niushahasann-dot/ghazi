# GEMINI_API_KEY: کلید API جمینای (در پنل ریلوی در بخش Variables وارد کنید)
# برای دریافت رایگان به aistudio.google.com مراجعه کنید.
GEMINI_API_KEY="AIzaSy..."

# GEMINI_BASE_URL: اختیاری - در صورت استفاده از پروکسی یا ریورس پروکسی اختصاصی
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

# PORT: پورت سرور (ریلوی به صورت خودکار پورت را ست می‌کند)
PORT=3000

# NODE_ENV: حالت پروداکشن برای ریلوی
NODE_ENV="production"
